
# Environment variables for Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT=https://oai-petshop-test.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_MODEL_DEPLOYMENT=gpt-4.1-mini_shopassist

# Environment variables for Kafka configuration for python ai-worker
KAFKA_GROUP_ID=ai-worker-group
KAFKA_TOPICS=gps-pings
KAFKA_ALERT_TOPIC=ai-alerts

TITLE=FleetPulse AI Worker.
DESCRIPTION=AI Worker for FleetPulse System
