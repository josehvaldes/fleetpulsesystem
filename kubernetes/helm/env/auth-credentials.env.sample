# sample of the "auth-credentials.env" that will have the authentication secrets and values:
#
# Install the secret resources with this command:
# kubectl -n fleetpulse create secret generic fleetpulse-auth-credentials \
#  --from-env-file=env/auth-credentials.env --dry-run=client -o yaml | kubectl apply -f -

Authentication__Mode=both
Authentication__EntraId__Scheme=EntraIdAuth
Authentication__EntraId__ClientId=00000000-0000-0000-0000-000000000000
Authentication__EntraId__TenantId=00000000-0000-0000-0000-000000000000
Authentication__Local__Jwt__Scheme=LocalAuth
Authentication__Local__Jwt__Secret=your-dev-secret-at-least-32-chars-long
Authentication__Local__Jwt__Issuer=FleetPulse
Authentication__Local__Jwt__Audience=FleetPulseAudience

Authentication__Local__Auth__DefaultUserId=15917232-b4fb-4a48-b341-488e38b6540d
Authentication__Local__Auth__DefaultUsername=admin
Authentication__Local__Auth__DefaultPassword=adminfleet