{
  "ConnectionStrings": {
    "FleetPulseDb": "Host=timescaledb;Port=5432;Database=fleetpulse;Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning"
      }
    }
  },
  "AppSettings": {
    "AppName": "FleetPulse.Api",
    "AppVersion": "1.0.0",
    "ApiVersion": "v1"
  },
  "Authentication": {
    "Mode": "both",
    "EntraId": {
      "Scheme": "EntraIdAuth",
      "ClientId": "00000000-0000-0000-0000-000000000000",
      "TenantId": "00000000-0000-0000-0000-000000000000"
    },
    "Local": {
      "Jwt": {
        "Scheme": "LocalAuth",
        "Secret": "",
        "Issuer": "",
        "Audience": ""
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://fleetpulse.frontend.future.com:3000"
    ]
  },
  "AllowedHosts": "*"
}
