{
  "ConnectionStrings": {
    "FleetPulseDb": "Host=localhost;Port=5432;Database=fleetpulse;Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Secret": "your-dev-secret-at-least-32-chars-long",
    "Issuer": "FleetPulse",
    "Audience": "FleetPulseAudience",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RefreshTokenRetentionDays": 30
  },
  "AuthSettings": {
    "DefaultUserId": "15917232-b4fb-4a48-b341-488e38b6540d",
    "DefaultUsername": "${DEFAULT_USERNAME}",
    "DefaultPassword": "${DEFAULT_PASSWORD}"
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092", //external listener for redpanda in docker-compose. Use internal listener for production deployment
    "GroupId": "fleetpulse-hub-consumer",
    "Topic": "gps-pings",
    "AutoOffsetReset": "Earliest", // Options: Earliest, Latest, Error. Start from the earliest message if no offset is found
    "EnableAutoCommit": "true", // Options: true, false. Automatically commit offsets after processing messages
    "StatisticsIntervalMs": 5000 // Interval for Kafka consumer statistics in milliseconds
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
