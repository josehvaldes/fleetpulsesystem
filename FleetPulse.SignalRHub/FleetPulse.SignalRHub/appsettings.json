{
  "ConnectionStrings": {
    "FleetPulseDb": "Host=timescaledb;Port=5432;Database=fleetpulse;Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning"
      }
    }
  },
  "AppSettings": {
    "AppName": "FleetPulse.SignalRHub",
    "AppVersion": "1.0.0",
    "ApiVersion": "v1"
  },
  "Authentication": {
    "Mode": "both", // Options: local, msal, both
    "EntraId": {
      "Scheme": "EntraIdAuth",
      "ClientId": "00000000-0000-0000-0000-000000000000",
      "TenantId": "00000000-0000-0000-0000-000000000000",
      "ClientSecret": ""
    },
    "Local": {
      "Jwt": {
        "Scheme": "LocalAuth",
        "Secret": "test-secret-key-long-enough-for-hmac-32+chars",
        "Issuer": "test-issuer",
        "Audience": "test-audience",
        "ExpiryMinutes": 15,
        "RefreshTokenExpiryDays": 7,
        "RefreshTokenRetentionDays": 30
      },
      "Auth": {
        "DefaultUserId": "00000000-0000-0000-0000-000000000000",
        "DefaultUsername": "",
        "DefaultPassword": ""
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "redpanda-0:9092",
    "GroupId": "fleetpulse-hub-consumer",
    "GpsPingsTopic": "gps-pings",
    "AlertsTopic": "ai-alerts",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": "true",
    "StatisticsIntervalMs": 5000
  },
  "SignalR": {
    "GpsPingCallbackMethod": "ReceiveGpsPing",
    "AlertCallbackMethod": "ReceiveAlert"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://fleetpulse.frontend.future.com:3000"
    ]
  },
  "AllowedHosts": "*"
}
