{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "AppSettings": {
    "AppName": "FleetPulse.YarpProxy",
    "AppVersion": "1.0.0",
    "ApiVersion": "v1"
  },
  "ReverseProxy": {
    "Routes": {
      "drivers": {
        "ClusterId": "fleetpulse-api",
        "Match": {
          "Path": "/api/v1/drivers/{**catch-all}"
        }
      },
      "alerts": {
        "ClusterId": "fleetpulse-api",
        "Match": {
          "Path": "/api/v1/alerts/{**catch-all}"
        }
      },
      "sessions": {
        "ClusterId": "fleetpulse-signalrhub",
        "Match": {
          "Path": "/api/v1/sessions/{**catch-all}"
        }
      },
      "fleet-hub": {
        "ClusterId": "fleetpulse-signalrhub",
        "Match": {
          "Path": "/v1/fleetHub/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "fleetpulse-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://fleetpulse-api:8080/"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        }
      },
      "fleetpulse-signalrhub": {
        "Destinations": {
          "destination1": {
            "Address": "http://signalr-hub:8080/"
          }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        }
      }
    }
  }
}
