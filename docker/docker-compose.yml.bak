name: fleetpulse-system
networks:
  fleetpulse_network:
    driver: bridge
volumes:
  redpanda-0: null
  emqx-data: null
  psgdata: null
  prometheus-data:
  grafana-data:
  tempo-data:

services:
  redpanda-0:
    image: docker.redpanda.com/redpandadata/redpanda:latest
    command:
      - redpanda
      - start
      - --kafka-addr internal://0.0.0.0:9092,external://0.0.0.0:19092
      - --advertise-kafka-addr internal://redpanda-0:9092,external://localhost:19092
      - --pandaproxy-addr internal://0.0.0.0:8082,external://0.0.0.0:18082
      - --advertise-pandaproxy-addr internal://redpanda-0:8082,external://localhost:18082
      - --schema-registry-addr internal://0.0.0.0:8081,external://0.0.0.0:18081
      - --rpc-addr redpanda-0:33145
      - --advertise-rpc-addr redpanda-0:33145
      - --smp 1
      - --memory 1G
      - --mode dev-container
    networks:
      - fleetpulse_network
    volumes:
      - redpanda-0:/var/lib/redpanda/data
    ports:
      - 18081:18081
      - 18082:18082
      - 19092:19092
      - 19644:9644

  console:
    image: docker.redpanda.com/redpandadata/console:v3.8.0
    networks:
      - fleetpulse_network
    ports:
      - 8080:8080
    environment:
      KAFKA_BROKERS: redpanda-0:9092
      KAFKA_SCHEMAREGISTRY_ENABLED: "true"
      KAFKA_SCHEMAREGISTRY_URLS: http://redpanda-0:8081
    depends_on:
      - redpanda-0

  emqx:
    image: emqx/emqx-enterprise:latest
    container_name: emqx
    ports:
      - "1883:1883"     # MQTT TCP
      - "8883:8883"    # MQTT SSL change from 8883 since that port is reserved by windows NAT
      - "8083:8083"     # MQTT WebSocket
      - "8084:8084"     # MQTT WebSockets SSL
      - "18083:18083"   # EMQX Dashboard Dashboard
    environment:
      - EMQX_NODE__NAME=emqx@redpanda-node
      - EMQX_DASHBOARD__DEFAULT_PASSWORD=emqx!@#$
      - EMQX_PROMETHEUS__ENABLE=true
      - EMQX_PROMETHEUS__PORT=18083
    volumes:
      - emqx-data:/opt/emqx/data
    networks:
      - fleetpulse_network
    depends_on:
      - redpanda-0

  emqx-bootstrapper:
    image: curlimages/curl:latest
    container_name: emqx_bootstrapper
    networks:
      - fleetpulse_network
    depends_on:
      emqx:
        condition: service_started
    volumes:
      # Mount the script we just created
      - ./bootstrap.sh:/bootstrap.sh 
    # Execute the script
    command: ["/bin/sh", "/bootstrap.sh"]
  
  # Add to docker-compose.yml
  timescaledb:
    image: timescale/timescaledb:latest-pg18
    env_file:
      - .env
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    ports:
      - "${DB_PORT:-5432}:${DB_PORT:-5432}"
    volumes:
      - psgdata:/var/lib/postgresql/
      - ../db/init.sql:/docker-entrypoint-initdb.d/01-init.sql
    networks:
      - fleetpulse_network

  prometheus:
    image: prom/prometheus:v3.6.0
    container_name: fleetpulse-prometheus
    volumes:
      - ./observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./observability/prometheus-alerts.yml:/etc/prometheus/alerts.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=15d'
      - '--web.enable-lifecycle'
    networks:
      - fleetpulse_network

  grafana:
    image: grafana/grafana:13.1.1
    container_name: fleetpulse-grafana
    volumes:
      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    ports:
      - "3000:3000"
    env_file:
      - .env
    environment:
      - GF_SECURITY_ADMIN_USER=${GF_SECURITY_ADMIN_USER}
      - GF_SECURITY_ADMIN_PASSWORD=${GF_SECURITY_ADMIN_PASSWORD}
      - GF_USERS_DEFAULT_THEME=dark
      - GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource
    networks:
      - fleetpulse_network

  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:v0.17.1
    container_name: fleetpulse-postgres-exporter
    env_file:
      - .env   
    ports:
      - "9187:9187"
    networks:
      - fleetpulse_network

  db-writer:
    image: fleetpulse-dbwriter:1.0
    env_file:
      - .env
    ports:
      - "8180:8080"
    networks:
      - fleetpulse_network

# FleetPulse Services:
  signalr-hub:
    image: fleetpulse-signalrhub:1.0
    env_file:
      - .env
    ports:
      - "8280:8080"
    networks:
      - fleetpulse_network

  ai-worker:
    image: fleetpulse-ai-worker:1.0
    environment:
      - PYTHONUNBUFFERED=1   # Ensures that Python output is sent straight to the terminal (e.g., your container log) without being buffered
    env_file:
      - .env
    volumes:
      - ../ai-worker/data:/app/data
    ports:
      - "8000:8000"
    networks:
      - fleetpulse_network

  fleetpulse-frontend:
    image: fleetpulse-frontend:1.0
    env_file:
      - .env
    ports:
      - "5173:80"
    networks:
      - fleetpulse_network

  loki:
    image: grafana/loki:2.9.5
    container_name: loki
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - loki-data:/loki
    networks:
      - redpanda_network

  promtail:
    image: grafana/promtail:2.9.5
    container_name: promtail
    volumes:
      # Mount the docker socket so Promtail can discover containers
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Mount the actual container log files
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      # Mount our custom promtail configuration
      - ./observability/promtail-config.yml:/etc/promtail/config.yml:ro
    command: -config.file=/etc/promtail/config.yml
    depends_on:
      - loki
    networks:
      - redpanda_network

  tempo:
    image: grafana/tempo:2.10.6
    container_name: fleetpulse-tempo
    command: [ "-config.file=/etc/tempo.yaml" ]
    volumes:
      - ./observability/tempo.yaml:/etc/tempo.yaml:ro
      - tempo-data:/var/tempo
    ports:
      - "3200:3200"   # Tempo UI and API
      - "4317"        # OTLP gRPC (internal, used by collector)
      - "4318"        # OTLP HTTP (internal, used by collector)
    networks:
      - redpanda_network

  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.158.0
    container_name: fleetpulse-otel-collector
    command: [ "--config=/etc/otel-collector-config.yaml" ]
    volumes:
      - ./observability/otel-collector-config.yaml:/etc/otel-collector-config.yaml:ro
    ports:
      - "4317:4317" # OTLP gRPC (Apps send traces here)
      - "4318:4318" # OTLP HTTP (Apps send traces here)
    depends_on:
      - tempo
    networks:
      - redpanda_network
