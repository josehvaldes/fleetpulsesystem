{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AppSettings": {
    "AppName": "FleetPulse.DbWriter",
    "AppVersion": "1.0.0"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Kafka": {
    "BootstrapServers": "redpanda-0:9092",
    "GroupId": "fleetpulse-db-writer",
    "Topic": "gps-pings",
    "HighSpeedCompressionThreshold": 40,
    "HighSpeedCompressionBucketKey": 15
  },
  "ConnectionStrings": {
    "FleetPulseDb": "Host=timescaledb;Port=5432;Database=fleetpulse;Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Prometheus": {
    "Enabled": true,
    "Port": 8080
  }
}
